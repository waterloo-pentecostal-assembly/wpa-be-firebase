{
    "name": "functions",
    "description": "Cloud Functions for WPA BE App V2",
    "scripts": {
        "lint": "eslint .",
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "test": "mocha test --recursive --exit"
    },
    "engines": {
        "node": "24"
    },
    "main": "src/index.js",
    "type": "module",
    "dependencies": {
        "@firebase/app": "^0.16.6",
        "@firebase/auth": "^1.13.10",
        "firebase-admin": "^14.5.1",
        "firebase-functions": "^7.4.0"
    },
    "devDependencies": {
        "chai": "^6.2.2",
        "eslint": "^8.57.1",
        "eslint-config-google": "^0.14.0",
        "mocha": "^12.0.3"
    },
    "private": true,
    "allowScripts": {
        "protobufjs": false,
        "@firebase/util": false
    }
}
